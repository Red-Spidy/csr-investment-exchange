# Copy to .env and fill in. .env is gitignored - never commit a real key.
DATABASE_URL=postgresql://csr:csr@localhost:5433/csr_exchange

# API (api/). `make api` sets CSR_ALLOW_RESET=1 for local development.
# Let POST /api/reset drop every table and reload the demo scenario.
# CSR_ALLOW_RESET=1
# The name recorded as verified_by when a milestone is verified or failed.
# CSR_REVIEWER=Reviewer
